# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Secrets — Supabase keys and any paid data-API credentials load from .env
# (flutter_dotenv, added in Phase 6). Never commit these.
.env
.env.*
!.env.example

# Supabase CLI local scratch state (project link, temp files)
supabase/.temp/

# Android release signing — passwords and the upload key itself.
# Committing either of these hands out the ability to sign as you.
android/key.properties
*.jks
*.keystore
