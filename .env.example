# Copy to .env and fill in from Supabase → Project Settings → API.
# One .env per environment (dev / staging / prod) — see DEPLOY.md §1c.
#
# Leaving these blank is supported: the app falls back to the on-device
# repositories and runs fully offline.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# NEVER put the service_role key here. It bypasses Row Level Security and this
# file's values are bundled into the shipped app.
